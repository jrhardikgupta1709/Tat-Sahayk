# ═══════════════════════════════════════════════
#  Tat-Sahayk Backend — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# Project
PROJECT_NAME=Tat-Sahayk Backend

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./tat_sahayak.db

# Security — CHANGE THIS in production!
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=

# Cloudinary (optional — leave empty for local file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
