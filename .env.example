# ═══════════════════════════════════════════════════════════
#  Tat-Sahayk — Environment Variables
#  Copy this file to backend/.env and ml-service/.env
# ═══════════════════════════════════════════════════════════

# ── Backend (.env → backend/.env) ─────────────────────────
PROJECT_NAME=Tat-Sahayk Backend
DATABASE_URL=sqlite:///./tat_sahayak.db
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ML_SERVICE_URL=http://localhost:8000

# Cloudinary (optional — leave empty for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── ML Service (.env → ml-service/.env) ───────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# OpenWeather API (optional — uses mock data if empty)
OPENWEATHER_API_KEY=
