# ═══════════════════════════════════════════════
#  Tat-Sahayk — Root .gitignore
# ═══════════════════════════════════════════════

# ── Environment / Secrets ─────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
*.egg-info/
dist/
build/

# ── Node ──────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Database ──────────────────────────────────
*.db
*.sqlite3

# ── Uploads (user-generated) ─────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── ML Model Artifacts ───────────────────────
*.pkl
*.pickle
*.h5
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.model
models/text_classifier/

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── OS / IDE ──────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Docker (runtime) ─────────────────────────
postgres_data/
redis_data/
